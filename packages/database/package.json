{
  "name": "@openedu/database",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio --schema prisma/schema.prisma",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force --schema prisma/schema.prisma",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "dotenv-cli": "^8.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
