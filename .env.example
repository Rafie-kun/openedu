# Copy to .env (never commit .env). Values here are placeholders only.

# ---------------------------------------------------------------- required
# PostgreSQL connection string used by Prisma and the web application.
DATABASE_URL="postgresql://edubuf:edubuf@localhost:5432/edubuf?schema=public"

# 32+ byte random secret. Used to sign session/CSRF material.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-long-random-string"

# Public base URL of the web application (no trailing slash).
APP_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"

# ---------------------------------------------------------------- optional
# Redis is used by Python ingestion workers for scheduling/queues.
REDIS_URL="redis://localhost:6379/0"

# AI assistant. Leave empty to run the platform without AI (fully supported).
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# S3-compatible object storage for student documents.
# STORAGE_DRIVER: "local" (development only) or "s3".
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""

# Optional email delivery (in-app notifications work without it).
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM=""

# Set to "true" only in local test environments to bypass rate limiting.
RATE_LIMIT_DISABLED="false"
